#!/usr/bin/env bash
#
# Tier-3 sub-29 Round-19/20 closure — pre-commit gate for the M7
# regression scanner. Runs ONLY the scanner test (~150ms) — fast enough
# to gate every commit without slowing the developer feedback loop.
#
# Activation (one-time per clone):
#
#   git config core.hooksPath .githooks
#
# After that, every `git commit` runs this hook automatically. To bypass
# in an emergency:
#
#   git commit --no-verify
#
# (Don't make a habit of bypassing — the scanner exists because four
# rounds of by-eye M7 sweeps each missed at least one leak.)
#
# Hook contract:
#   exit 0 → commit proceeds
#   exit 1 → commit aborted, scanner prints offender list + fix guide
#
# This hook does NOT run the full vitest suite — that's the Stop hook's
# job (`.claude/hooks/test-gate.sh`). Pre-commit deliberately scopes to
# the M7 scanner only so it stays under the developer-tolerance threshold
# for per-commit gating (~200ms).

set -euo pipefail

# Phase 0.7 (Turn XXXVI) — secret-leak gate runs FIRST. If a staged file
# contains an obvious API key / token, abort before running M7. ~50ms
# typical on a clean repo. See `.githooks/pre-commit-secrets.sh` for the
# pattern catalog + rationale.
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$HOOK_DIR/pre-commit-secrets.sh" ]; then
  if ! bash "$HOOK_DIR/pre-commit-secrets.sh"; then
    exit 1
  fi
fi

# Phase 1.3 (Turn CXXII) — tsc --noEmit type gate. Skips on doc-only /
# config-only commits to keep the per-commit cost predictable.
#
# Cost shape:
#   - No .ts/.tsx in staged diff → skip entirely (~0ms)
#   - Warm tsc cache → ~3-5s on this codebase (197 test files + src/)
#   - Cold tsc cache → ~10-15s (rare; only after `rm -rf node_modules`)
#
# Bypass in emergencies via `git commit --no-verify`.
ts_staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.(ts|tsx)$' || true)
if [ -n "$ts_staged" ] && [ -f "package.json" ] && command -v npx >/dev/null 2>&1; then
  echo "[pre-commit] Running tsc --noEmit (TS/TSX changes detected)…"
  if npx tsc --noEmit 2>&1; then
    echo "[pre-commit] tsc ✓ passed"
  else
    echo ""
    echo "[pre-commit] ❌ tsc FAILED — commit aborted."
    echo "  Fix the type errors above, re-stage, and commit again."
    echo "  Emergency bypass: \`git commit --no-verify\`."
    exit 1
  fi
fi

SCANNER_TEST_PATH="src/features/terminal/components/m7-status-band-shape.test.ts"

# Only run if package.json + vitest exist (e.g. skip on hook fired
# outside the project root).
if [ ! -f "package.json" ] || ! command -v npx >/dev/null 2>&1; then
  exit 0
fi

# Run scanner; on failure, vitest writes diagnostics to stderr and
# returns non-zero. We forward that as the hook exit code.
# Note: `--reporter=dot` is preferred over `--reporter=basic` because
# vitest 4.x removed `basic` as a valid reporter name (architect
# Round-21 closure — initial draft of this hook used --reporter=basic
# and aborted every commit with "Failed to load url basic"). `dot`
# emits one char per test and is the smallest valid option.
echo "[pre-commit] Running M7 status-band-shape regression scanner…"
if npx vitest run "$SCANNER_TEST_PATH" --reporter=dot; then
  echo "[pre-commit] M7 scanner ✓ passed"
  exit 0
else
  echo ""
  echo "[pre-commit] ❌ M7 scanner FAILED — commit aborted."
  echo "  Fix the offenders above, then re-stage and commit again."
  echo "  In an emergency, use \`git commit --no-verify\` to bypass."
  exit 1
fi
