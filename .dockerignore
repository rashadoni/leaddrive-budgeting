# Version control
.git
.gitignore
.gitattributes

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build artifacts (rebuilt inside the image)
.next
out
output

# Runtime/deploy artifacts. Production DB backups and the local revision
# stamp must never enter the Docker build context or BuildKit cache.
backups
.deploy-revision

# Environment (never baked into image — injected at runtime)
.env
.env.*
!.env.production.example

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Logs, caches, coverage
*.log
.cache
coverage
.nyc_output

# Documentation used by the in-app `/guide` route at runtime.
*.md
!docs/**
!deploy/README.md
.claude

# Git hooks (not needed in image)
scripts/pre-commit-secret-scan.sh
scripts/install-git-hooks.sh

# Local DB dumps
*.sql
*.dump
