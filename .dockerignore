# Version control
.git
.gitignore
.gitattributes

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js build artifacts (rebuilt inside the image)
.next
out

# Environment (never baked into image — injected at runtime)
.env
.env.*
!.env.production.example

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Logs, caches, coverage
*.log
.cache
coverage
.nyc_output

# Documentation & internal tooling (not needed in image)
docs
*.md
!deploy/README.md
.claude

# Git hooks (not needed in image)
scripts/pre-commit-secret-scan.sh
scripts/install-git-hooks.sh

# Local DB dumps
*.sql
*.dump
