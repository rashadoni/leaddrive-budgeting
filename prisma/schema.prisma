// ═══════════════════════════════════════════════════
// PHASE 7: RISK & PERFORMANCE INDICATORS
// Enterprise Holding Risk Terminal — foundation models.
// See docs/ROADMAP.md § Phase 7 and .claude/plans/dreamy-leaping-manatee.md
// ═══════════════════════════════════════════════════

// Company — 2-level hierarchy within a holding (Organization).
// Level 1 (parentCompanyId = null) = sub-group (Tabia, AFI, Azmade, PMD, Novex, Azersheker, Separated).
// Level 2 (parentCompanyId set)    = operational entity (HILTON GARDEN AGHDAM MMC, etc.).
model Company {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentCompanyId  String?
  parent           Company?     @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  children         Company[]    @relation("CompanyHierarchy")
  code             String // short mnemonic for command bar: "HLTN", "TABIA", "AAC"
  name             String
  nameAz           String?
  nameRu           String?
  nameEn           String?
  industry         String? // FK on Industry.code when set; application layer enforces "null for level=1, required for level=2"
  industryRef      Industry?    @relation(fields: [industry], references: [code], onDelete: Restrict, onUpdate: Cascade)
  level            Int          @default(2) // 1 = sub-group, 2 = operational
  // Phase 7.E foundation — cost-centre role taxonomy.
  //   operational — line-of-business with revenue + cost; full
  //                 indicator-pack scoring applies.
  //   admin       — pure cost-centre (e.g. holding HQ, ATL-MRKZ);
  //                 exempt from operational-threshold scoring (would
  //                 false-red on OpEx ratios since they have no
  //                 revenue base).
  //   holding     — top-level holding entity; aggregated views only.
  // Default `operational` keeps existing Phase 7 behavior unchanged.
  // Set explicitly via UI / seed when an entity is admin-only.
  // Phase 7.E hardening (Turn 10): String → enum so typos like "Admin"
  // can't silently bypass the operational filter.
  role             CompanyRole  @default(operational)
  country          String? // ISO-2
  baseCurrencyCode String?
  settings         Json? // per-industry config: { totalRooms?, feedSpecies?, ... }
  isActive         Boolean      @default(true)
  // Truth-infra C.1 — onboarding readiness gate.
  //   'pending' (default for new rows) — company exists in tree but
  //              no data ingested yet; terminal CompanyTree hides by
  //              default to avoid showing empty cells.
  //   'active'  — at least one IndicatorValue or BudgetLine recorded;
  //              terminal surfaces normally.
  //   'archived' — formerly active, manually retired; terminal hides
  //              same as 'pending' (but visible to admin).
  // Set via /api/companies/[id]/status PATCH (admin) or auto-promoted
  // pending→active by the onboarding-completion reconciler.
  status           String       @default("pending")
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  budgetLines           BudgetLine[]
  budgetActuals         BudgetActual[]
  bookings              Booking[]
  operationalFacts      OperationalFact[]
  indicatorValues       IndicatorValue[]
  // Phase 7.H F4.v2.3 — manual disclosure overrides for modeled-generic
  // ESG indicators. See `IndicatorDisclosure` model below.
  indicatorDisclosures  IndicatorDisclosure[]
  // Phase 7.H Feature 5 — client-reported reconciliation reference values.
  clientReconciliations ClientReconciliation[]
  companyIndicators     CompanyIndicator[]
  importStaging         ImportStaging[]
  // Phase 7.J — top customers / suppliers register (HHI, contract
  // expiry, single-source dependencies). Drives the Concentration
  // panel + AI Variance Explainer's "what if X customer leaves"
  // narrative.
  counterparties        Counterparty[]
  // Phase 7.O — company-scoped balance sheet lines for per-entity
  // resolver queries (inventory, equity, etc).
  balanceSheetLines     BalanceSheetLine[]
  // 2026-06-23 — company-scoped cash flow (CF double-layer fix).
  cashFlowEntries       CashFlowEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, parentCompanyId, industry])
  @@index([organizationId, level])
  @@map("companies")
}

// Phase 7.E hardening (Turn 10) — typed cost-centre role.
// String column hardened to enum so typos like "Admin" / "Operational"
// can't silently bypass `filterOperationalCompanies` and false-red
// the holding view.
enum CompanyRole {
  operational
  admin
  holding
}

// Industry — seed taxonomy (hospitality, agro_crops, poultry, ...).
// Shared catalog, not org-scoped. Seeded at 7.A via scripts/seed-industries.ts.
model Industry {
  code      String    @id // "hospitality" | "food_processing" | "agro_crops" | ...
  companies Company[]
  nameEn    String
  nameAz    String?
  nameRu    String?
  category  String? // optional UI grouping ("agro_umbrella", etc.)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@map("industries")
}

// IndicatorValueSource — Phase 7.H F4.v2.1 provenance ladder (Bloomberg-
// style). Tags every IndicatorValue with where its number came from so
// modelled estimates (e.g. carbon Scope 1 derived from revenue × generic
// 0.5 kg/AZN factor) are visually distinguishable from disclosed facts
// and from real financial aggregates. Values:
//   - disclosed         : company-reported fact (manual entry / import)
//   - modeled_industry  : industry-specific intensity factor (v2.2+)
//   - modeled_generic   : v1 placeholder formula (revenue × constant)
//   - macro             : single-value macro context (same across cos)
//   - computed          : derived from real BudgetLine / OperationalFact /
//                         Booking data; the financial / operational default
enum IndicatorValueSource {
  disclosed
  modeled_industry
  modeled_generic
  macro
  computed

  @@map("indicator_value_source")
}

// IndicatorDefinition — formula-as-data. Each indicator stores an expression
// string evaluated by src/lib/risk/formula-engine.ts (expr-eval, sandboxed).
// organizationId = null  → global seed (shipped with the product)
// organizationId = set   → org-specific override
model IndicatorDefinition {
  id                 String               @id @default(cuid())
  organizationId     String?
  organization       Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String // "HOSP_FX_EXPOSURE"
  nameEn             String
  nameAz             String?
  nameRu             String?
  category           String // "fx"|"commodity"|"operational"|"geopolitical"|"macro"|"regulatory"|"composite"|"esg"
  industries         String[] // which industries this indicator applies to (Postgres text[])
  unit               String // "AZN"|"%"|"ratio"|"nights"|...
  direction          String // "higher_better"|"lower_better"|"band"
  formula            String // expr-eval expression (see src/lib/risk/formula-engine.ts)
  sparklineFormula   String? // optional variant evaluated per period for sparkline
  thresholds         Json // { green:{op,value}, amber:{op,value}, red:{op,value} }
  hintTemplateEn     String?
  hintTemplateAz     String?
  hintTemplateRu     String?
  requiredInputs     String[] // ["budgetLine","booking","currencyRate","operationalFact",...]
  // Phase 7.H F4.v2.1 — default provenance tag stamped on every IV
  // produced from this definition. ESG v1 placeholders use
  // `modeled_generic`; macro indicators (e.g. IND_GOV_CLIMATE_SCORE) use
  // `macro`; financial / operational defaults to `computed`. Optional at
  // the seed level — null falls back to `computed` in recompute.
  defaultValueSource IndicatorValueSource @default(computed)
  // Phase 7.N C5 v2 — per-indicator weight for composite-risk-score.
  // Higher = more impact on the 0-100 health score.
  // Scale: 0.7 (ESG/sentiment — directional) → 1.0 (default) → 1.5 (profitability / liquidity — survival).
  weight             Float                @default(1.0)
  isActive           Boolean              @default(true)
  sortOrder          Int                  @default(0)
  // How the operationalFact resolver aggregates multiple in-period facts for
  // THIS indicator's metric inputs: "flow" = mean (additive/period metrics like
  // production volumes — the default), "snapshot" = latest-by-date (stock/
  // point-in-time metrics: legal-case counts, audit %, intensive ratios). Moves
  // the stock/flow decision to the seed (data) instead of a central regex.
  // 2026-05-31 — replaces SNAPSHOT_METRIC_RE.
  aggregation        String               @default("flow")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  values            IndicatorValue[]
  companyIndicators CompanyIndicator[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("indicator_definitions")
}

// CompanyIndicator — which indicators are enabled for which companies, with
// per-company threshold override. If no row exists, the default is "enabled
// when definition.industries contains company.industry".
model CompanyIndicator {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  indicatorId     String
  indicator       IndicatorDefinition @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  enabled         Boolean             @default(true)
  customThreshold Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([companyId, indicatorId])
  @@index([indicatorId])
  @@map("company_indicators")
}

// IndicatorValue — computed cache. Populated on-demand by src/lib/risk/compute.ts
// (dedicated cron scheduling comes later, Phase 6 infra).
model IndicatorValue {
  id             String               @id @default(cuid())
  organizationId String
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  indicatorId    String
  indicator      IndicatorDefinition  @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  period         String // "2026-04" | "2026-Q2" | "2026"
  value          Float
  status         String // "green"|"amber"|"red"|"unknown"
  sparkline      Json // (number|null)[] — 12-slot trailing-month series; nulls = evaluation gap (Bloomberg "no-tick")
  inputs         Json // snapshot of resolved vars (for audit/drill-down)
  // Phase 7.H F4.v2.1 — provenance stamp inherited from
  // `IndicatorDefinition.defaultValueSource` at upsert time. Drives the
  // UI provenance badge (panel 3) + heatmap-cell modeled marker, and is
  // surfaced verbatim on `/api/indicators/matrix` cells. Defaults to
  // `computed` so legacy rows (Phase 7.A-G) stay correct without a
  // re-recompute: every existing financial / operational IV is a real
  // derived value.
  valueSource    IndicatorValueSource @default(computed)
  // Reserved for Phase 7.H F4.v2.2 — model-confidence tier (A/B/C/D)
  // when an industry-specific factor is in play. Null until that phase
  // ships; UI shows badge without confidence sub-label until then.
  confidence     String?
  computedAt     DateTime             @default(now())
  // Financial-truth-infra Phase A.2 — provenance + reconciliation fields.
  // `sourceDocument` is a pointer to the original artifact this value was
  // ingested from: typically `filename.xlsx#sheet_name!row` for xlsx
  // imports, or `commodity-adapter:source-code` for external feeds.
  // `lastReconciledAt` / `reconciledBy` are populated by audit-company.cjs
  // when drift checks pass (or are manually signed off). `sanityBand`
  // stores the verdict from the industry sanity-band classifier so the
  // CompanyTree status badge can be computed without re-querying audit
  // results: "normal" | "low_extreme" | "high_extreme" | "missing_input"
  // | "no_band". All nullable for backward compat with pre-Phase-A IVs.
  sourceDocument    String?
  lastReconciledAt  DateTime?
  reconciledBy      String?
  sanityBand        String?
  // Phase 10 / Stage B5 — lineage. The DataRevision whose pinned source and
  // mapping state produced this value (03-DATA-KPI-TRUST-SPEC §5, ADR Trust
  // Core §4). Nullable and additive on purpose: every one of the 1,269 IVs
  // that predates this column is legacy and stays valid with `revisionId =
  // null`. There is no backfill — a revision cannot be invented for a value
  // whose sources were never recorded, and pretending otherwise is exactly the
  // false assurance Phase 10 exists to remove.
  //
  // Null means "untraced", which A5's gate already treats as not
  // decision-grade. A non-null revisionId is *evidence of lineage*, not a
  // promise of correctness: reconciliation, coverage and approval are separate
  // gates and remain unmet.
  //
  // Restrict (not Cascade/SetNull): deleting a revision that observations point
  // at would either destroy those observations or silently orphan their
  // lineage. Revisions are superseded, never deleted (§5.2).
  revisionId        String?
  revision          DataRevision? @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([companyId, indicatorId, period])
  @@index([organizationId, companyId, period])
  @@index([indicatorId])
  @@index([revisionId])
  @@map("indicator_values")
}

// IndicatorDisclosure — Phase 7.H F4.v2.3 manual-disclosure override for
// ESG / modeled-generic indicators. When a row exists for (companyId,
// indicatorCode, period), the recompute pipeline uses `value` instead
// of the seed formula and stamps `IndicatorValue.valueSource =
// 'disclosed'`. Without a row, the v2.1 modeled-generic placeholder
// stays active.
//
// Indicator code (not id) so disclosures keep working across
// IndicatorDefinition re-seeds that re-cuid the row. `period` mirrors
// the IndicatorValue period grammar ("YYYY" | "YYYY-QN" | "YYYY-MM").
// Each entry carries audit metadata (enteredBy / enteredAt /
// sourceNote) so a finance reviewer can later trace where the number
// came from. `unit` is required so a "kg" never lands silently into
// a "tonnes" slot.
model IndicatorDisclosure {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  indicatorCode  String
  period         String
  value          Float
  unit           String
  sourceNote     String? // free-form provenance note from the entering user
  enteredBy      String // User.id of the person who entered the row
  enteredAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, indicatorCode, period])
  @@index([organizationId, companyId])
  @@index([indicatorCode])
  @@map("indicator_disclosures")
}

// Phase 7.H Feature 5 — client-reported reference values for finance
// reconciliation. Unlike IndicatorDisclosure (which OVERRIDES the
// computed indicator value via `valueSource='disclosed'`), this table
// stores a PARALLEL reference number — what the client said the metric
// is in their own books — so the P&L screen can show variance without
// the recompute pipeline touching it. v1 ships EBITDA-only; the
// `indicatorKey` is a string so NET_MARGIN / ROE / NET_DEBT can be
// added later without a schema migration. Period format matches
// IndicatorValue grammar ("YYYY" | "YYYY-QN" | "YYYY-MM").
model ClientReconciliation {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period         String
  indicatorKey   String // v1: "EBITDA"; future: "NET_MARGIN", "ROE", "NET_DEBT"
  value          Float // can be negative (loss case)
  currency       String   @default("AZN") // ISO 4217
  note           String? // free-form provenance note
  submittedById  String? // User.id; null after user deletion (SetNull) to preserve trail
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, period, indicatorKey])
  @@index([organizationId, companyId, period])
  @@map("client_reconciliations")
}

// Booking — hospitality operational data. Feeds RevPAR, source-country HHI, etc.
// Manual entry in Phase 7.A–B; CSV import deferred to 7.2+.
model Booking {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  arrivalDate    DateTime
  departureDate  DateTime
  nights         Int
  revenue        Float
  currencyCode   String?
  exchangeRate   Float?
  sourceCountry  String // ISO-2 country code
  roomsBooked    Int?
  channel        String? // "direct"|"ota"|"corporate"|...
  isCancelled    Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([companyId, arrivalDate])
  @@index([organizationId])
  @@map("bookings")
}

// OperationalFact — generic metric storage for non-hospitality sectors.
// Avoids a separate table per industry (broiler weight, feed consumption,
// yield/hectare, milk yield, etc.).
model OperationalFact {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metric         String // "broiler_weight_avg_kg", "yield_per_hectare", ...
  date           DateTime
  value          Float
  unit           String?
  source         String? // "manual" | "import" | "api"
  createdAt      DateTime @default(now())

  @@index([companyId, date, metric])
  @@index([organizationId])
  @@map("operational_facts")
}

// Phase 7.J — Counterparty register (customers + suppliers). Captures
// top-N concentration ahead of HHI: % of revenue from each customer,
// contract expiry dates, payment-term days, single-source supplier
// dependencies. One row per (company × counterparty × role) pair.
// Annual snapshot — updated quarterly via admin form.
model Counterparty {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /** "customer" | "supplier". The same physical counterparty can hold
   *  both roles (e.g. trade partner that buys and sells) — store two
   *  rows in that case. */
  role           String
  /** Human-readable name (e.g. "Bakı Şirniyyat", "Coca-Cola Azerbaijan"). */
  name           String
  /** % of company's annual revenue (customer) or COGS (supplier).
   *  Stored as 0-100 (not 0-1) for direct display. */
  sharePct       Float        @default(0)
  /** Annual amount in baseCurrencyCode. Optional; derived from sharePct
   *  × total revenue/cogs at read time when null. */
  annualAmount   Float?
  /** Contract expiry date (ISO yyyy-mm-dd). Null = open-ended /
   *  rolling contract. */
  contractExpiry DateTime?
  /** Days from invoice → payment (net terms). Typical: 30, 45, 60, 90. */
  paymentTermsDays Int?
  /** True for single-source suppliers (no qualified alternate). Risk
   *  flag — appears in "Top-3 risks register" auto-derivations. */
  singleSource   Boolean      @default(false)
  /** Sugar pricing-escalator clauses, FX-pegged contracts, etc.
   *  Free-text. */
  notes          String?
  /** Period the snapshot is for (e.g. "2026" or "2026-Q1"). */
  period         String       @default("2026")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // Phase 7.M Step 4 (2026-05-18) — soft-delete for self-service archive.
  deletedAt      DateTime?
  deletedBy      String?

  @@unique([companyId, role, name, period])
  @@index([organizationId])
  @@index([companyId, role])
  @@index([role, sharePct])
  @@index([organizationId, deletedAt])
  @@map("counterparties")
}

// Alert — triggered events from indicator thresholds, composite rules, or AI briefs.
// Phase 9.8 (2026-07-06): activated as the trade alert INBOX — `domain`
// separates trade rows from the (dormant) risk usage; `dedupeKey` gives
// stable upserts so re-evaluation updates instead of duplicating;
// `resolvedAt` lets the evaluator auto-close alerts whose condition
// cleared (distinct from user `acknowledgedAt`).
model Alert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String // "indicator"|"composite"|"scenario"|"brief"|"trade_pacing"
  domain         String       @default("risk") // "risk" | "trade"
  sourceRef      Json // { companyId?, indicatorId?, ruleId?, grainKey?, period? }
  severity       String // "info"|"warn"|"critical"
  title          String // EN fallback — always populated
  message        String // EN fallback — always populated
  // R5 (2026-07-07) — i18n: UI renders trade.alertRules.<key>.{title,message}
  // with messageParams (pre-formatted strings); EN columns above stay the
  // fallback + email-digest source. Mirrors AlertEvent's messageKey pattern.
  messageKey     String?
  messageParams  Json?
  dedupeKey      String?
  triggeredAt    DateTime     @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, triggeredAt])
  @@index([organizationId, acknowledgedAt])
  @@index([organizationId, domain, resolvedAt])
  @@map("alerts")
}

// AlertEvent — Phase 7.E C6 v3 (Turn III) latest stored `evaluateAlertRules`
// match snapshot for one organization + period. The `Alert` model above is
// user-acknowledgeable inbox-style; AlertEvent is a replace-on-success snapshot
// for the feed / digest emails, not an immutable history of recompute runs.
//
// Persistence semantics: write path is "delete-by-(orgId, period) then insertMany"
// — current state for a given period is the latest evaluator output. Historical
// Re-evaluating the same (orgId, period) and successfully persisting it produces
// a replacement row set with newer emittedAt. A persistence failure can leave
// the prior snapshot in place.
//
// `affectedCompanyIds` stored as a `String[]` Postgres array (native Prisma),
// keeping single-row reads cheap. `messageParams` stored as Json blob to keep
// the rule-shape contract loose (per AlertRule's deferred discriminated-union).
model AlertEvent {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period                 String // matches IndicatorValue.period (e.g. "2025" or "2025-04")
  ruleId                 String // matches AlertMatch.ruleId (DEFAULT_ALERT_RULES[].id)
  ruleName               String
  severity               String // "critical"|"warning"|"info"
  message                String // EN template-output (always populated for non-React/CLI consumers)
  messageKey             String // i18n key (terminal.alerts.messages.<ruleId>)
  messageParams          Json // ICU placeholder values
  affectedCompanyIds     String[] // company IDs in the matched set
  affectedIndicatorCodes String[]     @default([]) // indicator codes (when applicable)
  emittedAt              DateTime     @default(now())

  @@index([organizationId, period, emittedAt])
  @@index([organizationId, ruleId, emittedAt])
  @@map("alert_events")
}

// Phase 7.G Turn XLII (Phase D.1) — AI Web Crawler intel feed.
//
// Per-org news/intel item produced by the daily Anthropic web_search
// crawl. Indexed by relevanceScore + tags so the Risk Terminal panel
// can surface high-signal items first and let users filter by
// industry / company tag. Pinned items survive cleanup runs;
// dismissed-by-user IDs prevent re-render after explicit hide.
//
// Source: Anthropic `messages.create` with `web_search_20250305` tool.
// Same SDK + auth pattern as `/api/budgeting/ai-analytics` route.
// No vendor-specific keys — reuses the project's single ANTHROPIC_API_KEY.
model IntelItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  summary        String // 1-3 sentence LLM-generated summary
  url            String // canonical source URL
  urlHash        String // sha256 of URL for dedup
  sourceLabel    String // human-readable source name (e.g. "Reuters", "Bloomberg")
  relevanceScore Float // 0..1; LLM-scored relative to org's industry/company tags
  industryTags   String[]     @default([]) // e.g. ["industrial","hospitality"]
  companyTags    String[]     @default([]) // company codes mentioned in the article
  publishedAt    DateTime? // article publish date if extractable
  fetchedAt      DateTime     @default(now())
  isPinned       Boolean      @default(false)
  // Phase 7.H Feature B — LLM-scored sentiment in [-1, +1] range.
  // NULL = unscored (legacy rows pre-Feature B, or batch failures).
  // Resolver `news.sentimentRolling30d` skips NULLs when averaging.
  sentimentScore Float?
  // Architect Turn-XLII Suggestion: `dismissedBy String[]` is fine for
  // Phase D.1-D.3 volumes (<1K dismissals/org). At Phase D.5+ scale
  // (thousands of users × thousands of items), migrate to a
  // `DismissedIntelItem (userId, intelItemId)` join table with a
  // `(userId, intelItemId)` unique index — enables `WHERE NOT EXISTS(...)`
  // with a B-tree index instead of GIN array contains. Migration path:
  // backfill from existing arrays, then drop the column.
  dismissedBy    String[]     @default([]) // user IDs that dismissed this item

  // intel_items_sentiment_lookup_idx is a partial index (WHERE
  // sentimentScore IS NOT NULL) created via raw SQL migration; Prisma's
  // schema language can't model partial indexes today. Visible to db
  // pull but absent from diff.
  @@unique([organizationId, urlHash]) // hash-dedup within org × 7-day window enforced at write time
  @@index([organizationId, fetchedAt(sort: Desc)])
  @@index([organizationId, relevanceScore(sort: Desc)])
  @@map("intel_items")
}

// Phase 7.G E.2 v2 — Board Deck narration cache.
// AI narrative shifted from opt-in `?narrate=1` (Turn XLVI) to ON BY
// DEFAULT in Board Deck v2; without caching, every page-load would
// burn ~$0.05 + 10-30s per LLM call. Cache key is
// (organizationId, period, snapshotHash, language) — snapshotHash is
// a sha256 over the load-bearing fields of `BoardSnapshot` (totals,
// composite scores, alert counts) deliberately excluding generatedAt
// so identical snapshots fetched milliseconds apart hit the same
// cache row. 24h TTL applied at read time (`getOrCreateNarration`
// regenerates anything older even if hash matches — guards against
// stale narrative on a slow-changing snapshot).
model BoardDeckNarration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period         String // YYYY or YYYY-MM (mirrors IndicatorValue.period)
  snapshotHash   String // sha256 over BoardSnapshot's load-bearing fields
  language       String // "en" | "ru" | "az"
  headline       String
  paragraphs     String[] // length 3 (validateAndShape contract)
  modelName      String
  promptVersion  String
  tokensIn       Int          @default(0)
  tokensOut      Int          @default(0)
  generatedAt    DateTime     @default(now())

  @@unique([organizationId, period, snapshotHash, language])
  @@index([organizationId, period])
  @@map("board_deck_narrations")
}

// AlertRule — user-defined composite conditions evaluated after recompute.
// Example condition: { op:"count_in_status", industry:"hospitality", status:"amber", threshold:3 }
model AlertRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  condition      Json // rule DSL
  severity       String       @default("warn")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("alert_rules")
}

// Scenario — preset / ad-hoc stress tests. When an active Scenario is applied,
// the formula engine overlays its overrides onto resolver inputs before eval.
model Scenario {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String // "IRAN_HIGH", "AZN_DEVAL_20", ...
  nameEn         String
  nameAz         String?
  nameRu         String?
  description    String?
  overrides      Json // { fx_rates:{USD:1.9}, booking_drop_pct:{IR:80}, ... }
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("scenarios")
}

// Phase 7.B AI Data Mapper — staging table for proposed xlsx-to-CoA mappings.
// Workflow: user uploads xlsx → /analyze runs the AI mapper → row created here
// with proposal JSON → user reviews in wizard UI → /apply consumes the staging
// row, writes BudgetLine rows transactionally, marks staging.status='applied'.
//
// Status lifecycle:
//   pending   — proposal saved, awaiting user review
//   applied   — user confirmed; BudgetLine rows written
//   discarded — user rejected the proposal
//   expired   — auto-cleaned by cron after `expiresAt` (24h default)
//
// Why this exists rather than re-running the mapper at apply time: (1) LLM
// non-determinism — re-running could yield a different mapping; (2) cost —
// each call burns tokens; (3) auditability — staging is the snapshot of what
// the user actually saw and confirmed.
enum ImportStagingStatus {
  pending
  applied
  discarded
  expired
}

model ImportStaging {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status         ImportStagingStatus @default(pending)
  sourceFile     String // original filename for audit trail
  sourceSheet    String // sheet name within workbook
  // Snapshot of the AI mapper proposal (MappingProposal shape from
  // src/lib/onboarding/ai-mapper/types.ts). Never mutate after creation —
  // user overrides are stored separately in `userOverrides`.
  proposal       Json
  // User-applied overrides on top of proposal — same shape as proposal but
  // only the fields the user changed. Empty if user accepted as-is.
  userOverrides  Json?
  // Raw xlsx bytes are NOT stored here (could be huge). Instead, the path
  // to a temp upload that /apply re-reads. Caller is responsible for
  // cleanup. Enables re-running with overrides without re-uploading.
  xlsxTempPath   String?
  // Audit fields. createdBy is the User.id who triggered /analyze.
  createdBy      String
  creator        User                @relation("ImportStagingCreator", fields: [createdBy], references: [id])
  createdAt      DateTime            @default(now())
  expiresAt      DateTime // /apply rejects when now() > expiresAt
  appliedAt      DateTime? // null until /apply succeeds
  errorMessage   String? // populated when status transitions to discarded with error

  @@index([organizationId, status])
  @@index([companyId])
  @@index([expiresAt])
  @@map("import_staging")
}

// Phase 7.F — audit log of high-business-impact writes on the holding tree.
//
// What we log: financial governance actions (budget plan create/approve),
// data ingestion (xlsx imports, AI-mapper staging applies), and Phase 7.E
// scoring-impact toggles (company role changes — admin↔operational changes
// which entities count toward holding-level KPIs). Read-only events are
// NOT logged — querying the heatmap or opening a panel doesn't constitute
// a meaningful audit trail signal at this layer.
//
// What we DON'T log: per-cell value reads, panel-layout changes, login
// events (handled separately by next-auth). Writes that are pure
// derived-data refresh (recompute fan-out) are also unlogged — the
// triggering action is logged, the cascade is implicit.
//
// Retention policy: 365 days in the primary table. Auto-prune is
// deferred to Phase 6 (BullMQ) — until then the table grows monotonically
// and is safe to truncate manually for dev environments.
//
// `metadata` shape varies per action; per-action contracts are documented
// in `src/lib/audit/log.ts` and enforced via TypeScript discriminated
// unions at the call site. Never include secrets / raw user input
// payloads — only structured diffs (e.g. role-change `{from, to}`).
//
// `context` is a defensive bag for incident-response forensics: which
// API route the event originated from, a hashed IP fragment if present.
// Optional + nullable so non-HTTP call-sites (CLI scripts) can omit it.

// ═══════════════════════════════════════════════════
// CHART OF ACCOUNTS — ROLE ENUM
// Phase 7.G Turn LXXV (Phase 5.1 — ChartOfAccount.role refactor).
// Finer-grained P&L bucket than the legacy `accountType` column.
// `unknown` covers balance-sheet codes (asset/liability/equity) and
// any code that doesn't match the AAC-specific prefix rules — the
// fallback for callers that need to filter "P&L-only" accounts.
// ═══════════════════════════════════════════════════
enum CoARole {
  revenue // 601, 611 (top-line) + 602, 603 (contra-revenue, sign-flip at consumer)
  cogs // 701
  opex // 711, 721
  finance // 731 (interest, finance costs)
  tax_costs // 741 (pre-EBIT tax-classed costs)
  non_operating // 751, 761, 771
  tax // 801 (corporate income tax)
  unknown // balance-sheet (1xx-5xx) or unrecognized
}

// ═══════════════════════════════════════════════════
// Phase 7.G Turn LXXXXI batch — 7 v2 model promotions.
// Each model migrates from in-memory implementation (LXXXXVI/LXXXXVII/
// LXXXXVIII) to durable Prisma persistence. Routes/wrappers detect Prisma
// availability + fall back to in-memory if generate hasn't yet propagated.
// ═══════════════════════════════════════════════════

// Phase 7.B v2 Day 3 — AI Mapper proposal cache.
// Promotes `src/lib/onboarding/ai-mapper/proposal-cache.ts` Map → Postgres.
model AIMapperProposalCache {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// sha256 over column header text + sample TYPES (NOT values) + industry + language
  structureHash  String
  promptVersion  String
  modelName      String
  /// Frozen MappingProposal (columns + accountTypeOverrides + summary) — no anomalies (heuristic re-runs on hit)
  proposal       Json
  /// LLM-flagged anomalies cached (merge with fresh heuristic on cache hit)
  llmAnomalies   Json
  tokensIn       Int
  tokensOut      Int
  /// Phase 7.B v2 Day 5 — template promotion (bypasses TTL when true).
  isTemplate     Boolean      @default(false)
  templateName   String?
  applyCount     Int          @default(0)
  lastUsedAt     DateTime?
  cachedAt       DateTime     @default(now())

  @@unique([organizationId, structureHash, promptVersion, modelName])
  @@index([organizationId, isTemplate, lastUsedAt(sort: Desc)])
  @@map("ai_mapper_proposal_cache")
}

// Phase 7.B v2 Day 6 — per-org LLM token usage tracking.
// Promotes `src/lib/llm/cost-budget.ts` Map → Postgres.
model AITokenUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD UTC bucket
  date           String
  tokensIn       Int          @default(0)
  tokensOut      Int          @default(0)
  calls          Int          @default(0)

  @@unique([organizationId, date])
  @@index([organizationId, date(sort: Desc)])
  @@map("ai_token_usage")
}

// Phase 7.E #1 D.5b — external intelligence numeric series (FX rates, CPI, commodities).
// Sister to IntelItem (article-shaped). Distinct table because shape diverges:
// IntelItem = unstructured news; IntelDataPoint = numeric time series.
model IntelDataPoint {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// e.g. "tcmb-fx-rates", "worldbank-cpi", "commodities-rss-brent"
  sourceCode     String
  /// e.g. "USD_AZN", "AZ_CPI_YOY", "BRENT_USD_BBL"
  metric         String
  /// Time the datapoint applies to (NOT when it was fetched)
  datetime       DateTime
  value          Float
  /// e.g. "ratio", "%", "USD/bbl"
  unit           String?
  /// Raw source payload for audit / re-parsing
  raw            Json?
  fetchedAt      DateTime     @default(now())

  @@unique([organizationId, sourceCode, metric, datetime])
  @@index([organizationId, sourceCode, datetime(sort: Desc)])
  @@map("intel_data_points")
}

// Phase 7.E #2 v2 E.1a — Variance Explainer cache promotion.
// Promotes `src/lib/risk/explainer-cache.ts` Map → Postgres.
model VarianceExplanation {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  indicatorValueId String
  /// EN/RU/AZ
  language         String
  promptVersion    String
  /// sha256 over (indicator, period, value, status, resolved-inputs, errorCode, industry, tags) — value-sensitive
  snapshotHash     String
  /// Full VarianceExplainerOutput (narrative, recommendations, topDrivers, confidence, modelName, promptVersion)
  output           Json
  tokensIn         Int
  tokensOut        Int
  cachedAt         DateTime     @default(now())

  @@unique([organizationId, indicatorValueId, language, promptVersion, snapshotHash])
  @@index([organizationId, indicatorValueId, cachedAt(sort: Desc)])
  @@map("variance_explanations")
}

// Phase 7.E #3 E.2b — predictive breach scanner output.
// Cross-cell breach forecasts persisted per recompute cycle.
model PredictiveBreach {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId          String
  /// Indicator code (not id — denormalised for query speed)
  indicatorCode      String
  /// Period the FORECAST applies to (e.g. "2026-Q4" if scanning from Q3)
  period             String
  /// 1 = next period, 2 = +2 periods, 3 = +3 periods (max horizon)
  horizonStep        Int
  /// "green"|"amber"|"red"|"unknown" — current actual status
  currentStatus      String
  /// "green"|"amber"|"red"|"unknown" — forecast at horizon
  predictedStatus    String
  /// 0..1 LLM/OLS confidence in the forecast
  forecastConfidence Float
  /// "low"|"medium"|"high" — discrete band derived from confidence
  confidenceBand     String
  /// Forecast value with 95% CI (margin of error)
  predictedValue     Float
  predictedLower     Float?
  predictedUpper     Float?
  /// Free-form drivers cited by the forecaster (top-3)
  drivers            Json?
  computedAt         DateTime     @default(now())

  @@unique([organizationId, period, companyId, indicatorCode, horizonStep])
  @@index([organizationId, period, horizonStep, confidenceBand])
  @@map("predictive_breaches")
}

// Phase 7.L — External-feed crossing impact forecaster output.
// When a feed (FAO, Brent, AZN/USD, etc.) crosses a threshold, an LLM
// produces 3 scenarios (best/likely/worst) per affected operational
// company. Persisted both for cache (avoid re-burning tokens on same
// trigger) and audit (forensic trace of which feed shock predicted
// what P&L impact).
model FeedImpactForecast {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Originating adapter (e.g. "fao-food-prices", "eia-energy")
  triggerSourceCode   String
  /// Metric code that breached the threshold (e.g. "FAO_FFPI_NOMINAL")
  triggerMetric       String
  /// Latest observed value at the moment of trigger
  triggerValueRounded Float
  /// UTC datetime of the trigger data point
  triggerObservedAt   DateTime
  /// Which crossing-rule fired (cross-references DEFAULT_CROSSING_RULES.id)
  ruleId              String
  /// Affected company FK (cascade delete with company)
  affectedCompanyId   String
  /// Denormalised for query convenience
  affectedCompanyCode String
  /// JSON shape: { best: { projectedIndicatorValue, plDeltaAZN, deltaPct, drivers[], timeHorizon }, likely: {...}, worst: {...} }
  scenarios           Json
  /// Exactly 3 actionable recommendations (verb + target)
  recommendations     Json
  /// "low" | "medium" | "high"
  confidence          String
  /// EN | RU | AZ
  language            String
  /// Stable hash of the system prompt — invalidates cache when prompt changes
  promptVersion       String
  /// sha256(companyFinancials + costStructure + triggerMetric) — invalidates when financials change
  snapshotHash        String
  tokensIn            Int
  tokensOut           Int
  generatedAt         DateTime     @default(now())

  @@unique([organizationId, triggerMetric, triggerValueRounded, affectedCompanyId, language, promptVersion, snapshotHash])
  @@index([organizationId, triggerSourceCode, generatedAt(sort: Desc)])
  @@index([organizationId, affectedCompanyCode, generatedAt(sort: Desc)])
  @@map("feed_impact_forecasts")
}

enum AuditAction {
  company_role_change // Phase 7.E scoring toggle
  budget_plan_create
  budget_plan_approve
  import_budget_create // /api/onboarding/import/budget
  import_staging_apply // /api/onboarding/import/staging/[id]/apply
  trade_import_apply // Phase 9.2 — POST /api/trade/master-import mode=apply
  trade_campaign_review // Phase 9.4 — approve/reject decision on a trade campaign
  trade_spend_entry // R8 — manual ledger posting or void (metadata.op)
  import_staging_expired // lazy-flip pending → expired on read
  indicator_override_create
  indicator_override_update
  indicator_override_delete
  ai_variance_explainer_run // Phase 7.E AI-suite — POST /api/indicators/values/[id]/explain
  ai_forecast_explainer_run // Phase C2 v2 — POST /api/indicators/values/[id]/forecast/explain
  alert_thresholds_update // Phase 7.E C6 v2 — PATCH /api/organizations/settings (alertThresholds)
  intel_crawl_run // Phase 7.G D.2 — POST /api/intel/refresh (AI Web Crawler)
  ai_board_deck_narration_run // Phase 7.G E.2 v2 — Board Deck narration cache miss (LLM call)
  period_lock_add // Phase 7.G Turn LXX — admin locked a fiscal period (CFO close action)
  period_lock_remove // Phase 7.G Turn LXX — admin unlocked a fiscal period (re-open trail)
  period_lock_blocked_mutation // Phase 7.G Turn LXX — 423 Locked fired; user attempted to mutate a closed period
  // Phase 7.G Turn LXXXXI batch (drift-resolution + 7 v2 model promotions).
  coa_role_change // Phase 5.1.2 — admin override of ChartOfAccount.role
  ai_mapper_proposal_cache_run // Phase 7.B v2 Day 3 — LLM call cache miss for AI Mapper
  ai_mapper_template_promote // Phase 7.B v2 Day 5 — user promoted cache entry → template
  ai_mapper_template_apply // Phase 7.B v2 Day 5 — template-fast-path apply (vs LLM call)
  ai_token_budget_exceeded // Phase 7.B v2 Day 6 — per-org daily/monthly token cap hit
  intel_data_source_run // Phase 7.E #1 D.5b — commodity/macro adapter executed
  predictive_breach_compute // Phase 7.E #3 E.2b — breach scanner executed
  ai_breach_digest // Phase 7.E #3 E.2e — daily breach delta digest
  user_access_change // Phase 7.F sub-group RBAC — admin updated User.allowedSubGroupIds
  user_role_change // Phase 7.F admin v2 — admin promoted/demoted a user's role
  user_create // Phase 7.F admin v3 — admin created a new user account
  user_password_reset // Phase 7.F admin v3 — admin generated a new temp password
  user_active_toggle // Phase 7.F admin v3 — admin enabled/disabled a user account
  ai_news_summary_run // Phase 7.H Feature 1 — Today's Brief AI news summary LLM call
  ai_morning_brief_run // Phase 7.E AI Morning Brief — composed narrative LLM call
  // Phase 7.H F4.v2.3 — manual data-entry trail for the non-engineer
  // admin flow at `/budgeting/admin/data-entry`. Three families:
  //   - operational_fact_* : ручной ввод KPI (yield, occupancy, FCR, etc.)
  //   - indicator_disclosure_* : ESG manual override of modeled value
  operational_fact_create
  operational_fact_update
  operational_fact_delete
  indicator_disclosure_create
  indicator_disclosure_update
  indicator_disclosure_delete
  // Phase 7.H Feature 5 — client-reported reconciliation reference values
  // (variance vs system EBITDA). `submit` covers both create and update
  // (upsert path) since the unique key is composite — metadata.previousValue
  // distinguishes the two cases for audit reviewers.
  client_reconciliation_submit
  client_reconciliation_delete
  // Phase 7.I — admin updated Company.settings JSON (per-industry
  // descriptors: hectares/region/cropType for agro_crops,
  // totalRooms/seasonality for hospitality, etc.). Metadata captures
  // before/after + changed keys so a reviewer can replay the change.
  company_settings_update
  // Financial-truth-infra Phase D.1 — nightly drift-watchdog detected
  // that one or more indicator values diverged from their last-audited
  // source xlsx (band changed, value drifted > threshold). Metadata
  // payload: { drifts: Array<{indicatorCode, beforeBand, afterBand,
  // beforeValue, afterValue, valueDriftPct}> }
  reconciliation_drift_detected
  // Financial-truth-infra Phase E.5 — recompute pipeline detected that
  // a locked + signed-off period's IV/BudgetLine rows produced a
  // different SHA-256 hash than the snapshot captured at lock time.
  // Means the signed numbers have silently drifted; surfaces in audit
  // log + drift dashboard. Metadata: { period, ivHashMatched,
  // budgetHashMatched, snapshotSignedAt }.
  period_snapshot_drift
  // Phase 7.K Phase 5a — admin set/cleared an external API key in
  // Organization.settings.apiKeys (EIA / USDA / Google Trends proxy).
  // Metadata: { updated: ["eia",…], cleared: ["usda",…] } — never the
  // key value itself, only which sources changed.
  api_key_update
  // Phase 7.M Step 4 (2026-05-18) — self-service archive trail.
  // `data_archive` flips deletedAt+deletedBy on a scope; `data_restore`
  // is the inverse. Metadata: { entityKind: "BudgetLine" |
  // "BalanceSheetLine" | "CashFlowEntry" | "Counterparty",
  // companyCode?, year?, period?, rowsAffected, reason? }. The
  // reason field is finance-user-supplied free text for the IFRS
  // 7-year audit trail.
  data_archive
  data_restore
  // 2026-06-21 — full per-company "reset imported data" (no-tails). Metadata:
  // { companyCode, year?, breakdown: {budgetLine, balanceSheetLine, cashFlowEntry,
  //   counterparty, operationalFact, budgetActual, settingsKeys}, rowsAffected, reason? }.
  data_reset
  // Phase 1.4 (2026-05-26) — BullMQ cleanup processor physically
  // removed soft-deleted rows whose deletedAt is older than the
  // 30-day retention window. One audit event per scheduled run with
  // metadata { counts: { budgetPlans, cashFlowEntries,
  // balanceSheetLines, counterparties, total }, cutoffDays,
  // durationMs }. Per-row audit was the data_archive event; this
  // closes the lifecycle.
  soft_delete_purge
  // Truth-infra Phase C.1 (2026-05-26) — admin manually flipped
  // Company.status via PATCH /api/companies/[id] { status }.
  // Metadata: { from, to, companyCode } — same shape as company_role_change
  // so audit-log UI can render both with the same template.
  company_status_change
  // Truth-infra Phase C.2 (2026-05-26) — admin reclassified a company's
  // industry via PATCH /api/companies/[id] { industry }.
  // Industry drives which indicator pack runs and which settings form shows
  // in CompanySettingsAdmin; correcting a mis-classified company requires
  // audit trail for compliance (wrong industry → wrong composite score).
  // Metadata: { from: string|null, to: string|null, companyCode: string }.
  company_industry_change
}

// Retention: 365 days from `createdAt`. Auto-prune is deferred to
// Phase 6 (BullMQ); until that lands the table grows monotonically and
// is safe to truncate manually for dev environments. The 365d window is
// a product decision (sufficient for annual-cycle compliance reviews
// without unbounded storage growth) — narrow it via a follow-up if
// regulators demand longer or if storage cost becomes the bottleneck.
model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // null when the action originated from a CLI script / cron / system
  // — keep cascade-on-delete distinct from the main org cascade so
  // deleting a user doesn't wipe their audit trail.
  actorUserId    String?
  actor          User?        @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action         AuditAction
  // Free-form so adding a new logged entity doesn't require a schema
  // migration; convention is the Prisma model name ("Company",
  // "BudgetPlan", "ImportStaging", ...). Lowercase-first variants
  // ("company") are also accepted but discouraged.
  entityType     String
  entityId       String? // null for bulk operations (e.g. multi-row import)
  metadata       Json
  context        Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, action, createdAt])
  @@map("audit_events")
}

/**
 * Financial-truth-infra Phase E.1 — period snapshot table.
 *
 * When admin locks a fiscal period via `/budgeting/admin/periods`, this
 * captures an immutable cryptographic fingerprint of all IndicatorValue
 * + BudgetLine rows for that period. Lets later recomputes prove they
 * haven't drifted from the signed-off numbers (compare new hash vs
 * stored hash).
 *
 * Storage strategy: instead of duplicating every row, store SHA-256 of
 * a canonical serialization (sorted by key, JSON.stringify) plus a
 * compact aggregate (revenue total, cogs total, line count). On
 * recompute, the same hashing routine runs and a divergence is logged
 * as `period_snapshot_drift` (next-slice audit action).
 *
 * Unsigned periods have no row here. Signed periods have exactly one
 * row per (organizationId, period). Re-signing a period (after manual
 * unlock + edit + relock) creates a new row; old rows retained for
 * historical comparison.
 */
model PeriodSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period         String // "YYYY" / "YYYY-Q[1-4]" / "YYYY-MM"
  signedAt       DateTime     @default(now())
  signedBy       String // userId
  // SHA-256 of the canonical JSON over all IndicatorValue rows at this
  // period (companyId, indicatorId, value, status sorted lex).
  ivHash         String
  // Same shape over BudgetLine rows (planId, companyId, accountId,
  // monthIndex, plannedAmount).
  budgetHash     String
  // Aggregate fingerprint that's cheap to display in the UI without
  // re-hashing — JSON of { ivCount, budgetLineCount, revenueTotal,
  // cogsTotal, ebitda }. Lets the terminal banner show "Q1 2026 —
  // signed by Rashad on 16.05.2026, Revenue 50.6M".
  aggregates     Json
  // Free-form admin commentary captured at lock time (optional).
  signoffNote    String?

  @@index([organizationId, period, signedAt])
  @@map("period_snapshots")
}

/**
 * Phase 8 F2 (2026-05-28) — first-party /guide page-view telemetry.
 *
 * Tracks which sections of the in-app User Guide are actually read,
 * per language, per user. No external provider (no Plausible /
 * Umami / GA dep) — values stay on the same DB the rest of the app
 * uses. Beacon posts to `/api/telemetry/guide-view` on initial mount
 * and on hash-anchor change.
 *
 * Minimal shape — just enough to answer «which sections do users
 * actually open» and «which language do они choose». PII-light:
 * actorUserId is nullable (anonymous sessions still log a viewedAt
 * for traffic counts). User-Agent stored truncated (no fingerprinting
 * attempt).
 *
 * Retention: indefinite for now — the table will grow ≤ a few rows per
 * user per day; physical purge cron (Phase 1.4) can sweep > 1y rows
 * later if disk pressure surfaces.
 */
model GuideView {
  id             String       @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  // null for anonymous sessions (unauthenticated /guide page-load).
  actorUserId    String?
  // ISO-639-1 of the language the user was reading (en / ru / az).
  lang           String
  // URL-fragment anchor the user scrolled to (#section-9-1) or null
  // when the viewer first mounts.
  anchor         String?
  // Truncated to 200 chars — enough for «Chrome 130 macOS» pattern
  // without storing high-entropy fingerprints.
  userAgent      String?
  viewedAt       DateTime     @default(now())

  @@index([organizationId, viewedAt])
  @@index([lang, viewedAt])
  @@map("guide_views")
}

// ═══════════════════════════════════════════════════
// PHASE 9: TRADE SPEND CONTROL TOWER (Mars Overseas)
// Design: docs/TRADE_SPEND_CONTROL_TOWER_PLAN.md
// Org-scoped operational mart, deliberately separate from the
// monthly budgeting models (BudgetLine/BudgetActual stay the
// planning source; trade gets daily grain + its own dimensions).
// Step 9.1 ships dimensions + spend types + import batch.
// Ledger/facts/campaigns land in steps 9.3–9.7.
// ═══════════════════════════════════════════════════

enum TradeAccrualMethod {
  on_invoice // discount visible on the invoice — accrues automatically at invoice time
  retro_formula // retro bonus computed by formula from period sales (engine in 9.6)
  payment_actual // known only when paid (promo payments, listing fees)
  free_goods // valued at COGS when the goods ship
  posm_merchandising // POSM/merchandising — actual on posting
  manual // manually entered adjustment (approval-gated)
}

enum TradeImportKind {
  master_outlets
  master_skus
  master_reps
  sales_invoice
  spend_actual
  campaign_master
  allocation
}

enum TradeImportStatus {
  preview
  applied
  superseded // replaced by a re-sent file covering the same scope
  failed
  discarded
}

model TradeRegion {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  name           String
  parentId       String? // optional hierarchy (zone -> region)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  outlets   TradeOutlet[]
  salesReps TradeSalesRep[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("trade_regions")
}

model TradeChannel {
  id             String    @id @default(cuid())
  organizationId String
  code           String
  name           String
  channelType    String // modern_trade | traditional | horeca | wholesale
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  outlets   TradeOutlet[]
  salesReps TradeSalesRep[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("trade_channels")
}

model TradeSalesRep {
  id             String        @id @default(cuid())
  organizationId String
  externalCode   String // rep code in the source system (Mikro / 1C / SFA)
  name           String
  regionId       String?
  region         TradeRegion?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  channelId      String?
  channel        TradeChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  outlets TradeOutlet[]

  @@unique([organizationId, externalCode])
  @@index([organizationId, deletedAt])
  @@map("trade_sales_reps")
}

model TradeOutlet {
  id             String         @id @default(cuid())
  organizationId String
  externalCode   String // outlet/customer code in the source system
  name           String
  legalName      String?
  taxId          String?
  chainCode      String? // modern-trade chain grouping (BRAVO, ARAZ, OBA...)
  regionId       String
  region         TradeRegion    @relation(fields: [regionId], references: [id])
  channelId      String
  channel        TradeChannel   @relation(fields: [channelId], references: [id])
  salesRepId     String?
  salesRep       TradeSalesRep? @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  // Optional bridge to the risk-module Counterparty snapshot for top customers.
  counterpartyId String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  @@unique([organizationId, externalCode])
  @@index([organizationId, regionId, channelId, salesRepId])
  @@index([organizationId, deletedAt])
  @@map("trade_outlets")
}

model TradeSku {
  id             String       @id @default(cuid())
  organizationId String
  externalCode   String // SKU code in the source system
  barcode        String?
  name           String
  brand          String // Pepsi, Mountain Dew, Lay's, Jala...
  category       String // csd | juice | water | snacks | ...
  packageSize    String? // "0.5L PET", "1.5L PET", "90g"
  unit           String       @default("ədəd")
  // Optional bridge to the monthly planning grain (ProductLine).
  productLineId  String?
  productLine    ProductLine? @relation(fields: [productLineId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  @@unique([organizationId, externalCode])
  @@index([organizationId, brand, category])
  @@index([productLineId])
  @@index([organizationId, deletedAt])
  @@map("trade_skus")
}

model TradeSpendType {
  id             String             @id @default(cuid())
  organizationId String
  key            String // stable key: on_invoice_discount, retro_bonus, ...
  label          String
  accrualMethod  TradeAccrualMethod
  // retro_formula parameters ({ pct, base, period }) — accrual engine in 9.6.
  formula        Json?
  sortOrder      Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  ledgerEntries TradeSpendLedger[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
  @@map("trade_spend_types")
}

enum TradeSpendEntryKind {
  plan
  accrued
  actual
}

// Phase 9.6 — append-only spend ledger: ONE table for plan/accrued/actual
// postings (UI pivots into three figures). Corrections are voids or
// negative postings — rows are never deleted. entryGroupKey ties a
// plan→accrual→actual chain (Phase-2 claim matching hook); importBatchId
// arrives with the 9.5 invoice adapter (on-invoice auto-accrual).
model TradeSpendLedger {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  entryKind      TradeSpendEntryKind
  spendTypeId    String
  spendType      TradeSpendType      @relation(fields: [spendTypeId], references: [id])
  campaignId     String?
  entryDate      DateTime
  year           Int
  month          Int // 1-12
  // Negative allowed (credit note / correction posting).
  amount         Float
  currencyCode   String              @default("AZN")
  regionId       String?
  channelId      String?
  salesRepId     String?
  outletId       String?
  skuId          String?
  // Free-text doc reference / note for manual postings.
  sourceDocument String?
  entryGroupKey  String?
  importBatchId  String?
  createdBy      String
  createdAt      DateTime            @default(now())
  voidedAt       DateTime?
  voidedBy       String?

  @@index([organizationId, year, month, entryKind])
  @@index([organizationId, spendTypeId, entryDate])
  @@index([organizationId, campaignId])
  @@map("trade_spend_ledger")
}

enum TradeRiskStatus {
  ok
  watch
  high
  critical
}

// Phase 9.7 — materialized daily plan (monthly SalesBudgetLine total ×
// working-day weights via spreadMonthlyPlan). Regenerated wholesale per
// (org, month, grain) whenever the monthly plan or the weight profile
// changes — rows are derived data, never hand-edited.
model TradePlanDaily {
  id                       String   @id @default(cuid())
  organizationId           String
  date                     DateTime
  year                     Int
  month                    Int // 1-12
  // Aggregation grain: "org" for the v1 whole-company view; finer grains
  // ("channel:<id>", "region:<id>", "campaign:<id>") arrive with 9.3
  // allocations.
  grainKey                 String
  plannedSalesAmount       Float    @default(0)
  plannedTradeBudgetAmount Float    @default(0)
  workingDayWeight         Float    @default(1)
  generatedAt              DateTime @default(now())

  @@unique([organizationId, date, grainKey])
  @@index([organizationId, year, month])
  @@map("trade_plan_daily")
}

// Phase 9.7 — persisted pacing snapshot per (org, as-of day, grain).
// `math` stores every input + intermediate of computePacing so finance
// can audit the run-rate arithmetic by hand (no-AI contract).
model TradePacingSnapshot {
  id                     String          @id @default(cuid())
  organizationId         String
  asOfDate               DateTime
  period                 String // "YYYY-MM"
  grainKey               String
  campaignId             String?
  salesPlanMtd           Float           @default(0)
  salesActualMtd         Float           @default(0)
  budgetMonth            Float           @default(0)
  controlSpendMtd        Float           @default(0)
  accruedSpendMtd        Float           @default(0)
  actualSpendMtd         Float           @default(0)
  forecastSalesMonth     Float?
  forecastSpendMonth     Float?
  forecastBudgetVariance Float?
  forecastSalesGap       Float?
  riskStatus             TradeRiskStatus
  math                   Json            @default("{}")
  generatedAt            DateTime        @default(now())

  @@unique([organizationId, asOfDate, period, grainKey])
  @@index([organizationId, period, riskStatus])
  @@map("trade_pacing_snapshots")
}

// Phase 9.3 — monthly trade budget pool. `salesPlanAmount` is captured
// from the org's revenue plan at derivation time (source: BudgetLine
// revenue rows of kind=budget plans — SalesBudgetLine was empty in every
// real org, deliberate deviation from the original design);
// budgetAmount = salesPlanAmount × budgetPct unless manually overridden.
// grainKey aligns with TradePlanDaily / TradePacingSnapshot ("org" v1;
// "channel:<id>" etc. when finer allocation lands).
model TradeBudgetPool {
  id              String   @id @default(cuid())
  organizationId  String
  year            Int
  month           Int // 1-12
  grainKey        String   @default("org")
  salesPlanAmount Float    @default(0)
  budgetPct       Float    @default(5)
  budgetAmount    Float    @default(0)
  // true when budgetAmount was set directly — re-derive keeps it.
  isManualAmount  Boolean  @default(false)
  currencyCode    String   @default("AZN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, year, month, grainKey])
  @@index([organizationId, year])
  @@map("trade_budget_pools")
}

enum TradeCampaignStatus {
  draft
  pending_approval
  approved // finance signed off; "running" is derived from the date range
  rejected // reviewer declined — editable again, can be resubmitted
  paused
  completed
  cancelled
}

model TradeCampaign {
  id                        String              @id @default(cuid())
  organizationId            String
  code                      String
  name                      String
  goal                      String?
  startDate                 DateTime
  endDate                   DateTime
  status                    TradeCampaignStatus @default(draft)
  plannedBudgetAmount       Float               @default(0)
  expectedSalesUpliftAmount Float?
  expectedSalesUpliftPct    Float?
  // Set when the activation request is approved (trail to ApprovalRequest).
  approvalRequestId         String?
  ownerUserId               String?
  currencyCode              String              @default("AZN")
  // Phase-2 hooks: roi, claim policy, simulation assumptions.
  settings                  Json                @default("{}")
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  deletedAt                 DateTime?
  deletedBy                 String?

  scopes TradeCampaignScope[]

  @@unique([organizationId, code])
  @@index([organizationId, status, startDate, endDate])
  @@index([organizationId, deletedAt])
  @@map("trade_campaigns")
}

model TradeCampaignScope {
  id             String        @id @default(cuid())
  organizationId String
  campaignId     String
  campaign       TradeCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scopeType      String // region | channel | rep | outlet | sku | brand | category
  scopeId        String? // dimension row id (region/channel/rep/outlet/sku)
  scopeValue     String? // free value (brand/category names)
  include        Boolean       @default(true)
  createdAt      DateTime      @default(now())

  @@index([organizationId, campaignId])
  @@map("trade_campaign_scopes")
}

model TradeImportBatch {
  id                String            @id @default(cuid())
  organizationId    String
  kind              TradeImportKind
  sourceSystem      String            @default("file") // file | mikro | 1c (post-migration)
  sourceFile        String
  fileHash          String // sha256 of the uploaded bytes — idempotency key
  // Business date the file covers (sales date for sales_invoice files).
  sourceDate        DateTime?
  status            TradeImportStatus @default(preview)
  rowCount          Int               @default(0)
  totals            Json              @default("{}") // control sums for reconciliation
  validation        Json              @default("{}")
  // Restatement chain: a re-sent file for the same scope supersedes the
  // previous batch — old batch deactivates, its rows are never deleted.
  supersedesBatchId String?
  isActive          Boolean           @default(false)
  createdBy         String
  createdAt         DateTime          @default(now())
  appliedAt         DateTime?

  @@unique([organizationId, kind, sourceSystem, fileHash])
  @@index([organizationId, kind, sourceDate, isActive])
  @@map("trade_import_batches")
}

/**
 * Phase 10 / Stage B2 — DataRevision: the exact source/mapping state a
 * downstream calculation used (03-DATA-KPI-TRUST-SPEC §5, ADR Trust Core §4).
 *
 * Makes one question answerable: given a number on screen, which sources and
 * mappings produced it, and has anything moved since? Today that question has
 * no answer — 0 of 1,269 IndicatorValue rows carry lineage — which is why A5
 * marks every coloured cell provisional.
 *
 * Every field here maps 1:1 onto `src/lib/risk/data-revision.ts`, which is the
 * contract of record. No field exists here that the spec does not name.
 *
 * **Immutability** (§5.2 / ADR §4) is enforced in the database by the
 * `data_revisions_immutable` trigger, not by convention: the pinned source
 * state (org, scope, reason, contentHash, createdAt/By) cannot be UPDATEd once
 * written. Only lifecycle columns move — lockedAt / reconciledAt / approvedAt
 * and supersededById — because §5.1 requires the revision to carry that state
 * and §5.2 has revisions superseded rather than edited.
 *
 * **Isolation**: RLS `tenant_isolation` is enabled in the same migration that
 * creates the table, so the table never exists without org isolation. Unset
 * `app.organization_id` yields NULL, which is not TRUE — deny by default.
 */
model DataRevision {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // §5.1 "organization and scope". Empty companyIds = org-wide. Stored as
  // arrays rather than join tables: a revision pins an immutable *snapshot* of
  // ids, so there is nothing to query or update relationally, and the content
  // hash already treats them as sets.
  companyIds        String[]
  // §5.1 "source batch/artifact identifiers".
  sourceArtifactIds String[]
  // §5.1 "mapping/version identifiers".
  mappingVersionIds String[]

  // §5.1 "period range" — period keys, per src/lib/risk/period-context.ts.
  periodFrom String
  periodTo   String

  // §5.1 "reason code".
  reason RevisionReason

  // §5.1 "createdAt/createdBy". Null actor = cron / script / system path,
  // matching AuditEvent.actorUserId. SetNull so deleting a user never erases
  // the provenance trail.
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("DataRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // §5.1 "supersedes/supersededBy". One-to-one self relation: a revision
  // replaces at most one predecessor and is replaced by at most one successor.
  supersedesId String?       @unique
  supersedes   DataRevision? @relation("DataRevisionSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy DataRevision? @relation("DataRevisionSupersedes")

  // §5.1 "lock/reconciliation/approval state". The only mutable columns.
  lockedAt     DateTime?
  reconciledAt DateTime?
  approvedAt   DateTime?

  // §5.1 "deterministic content hash" — SHA-256 over canonical JSON of
  // scope + reason. See computeRevisionContentHash().
  contentHash String

  /// Observations produced under this revision (Stage B5 lineage).
  indicatorValues IndicatorValue[]

  // Idempotency + duplicate protection (§5.2 "a source change creates a new
  // revision" — so an unchanged source state must NOT create one). The hash
  // excludes createdAt/lifecycle, so re-running an import that changed nothing
  // collides here and the write is a no-op rather than a phantom revision.
  // Org-scoped because the hash includes organizationId anyway; the composite
  // keeps the index useful under RLS.
  @@unique([organizationId, contentHash])
  @@index([organizationId, createdAt])
  @@index([organizationId, periodFrom, periodTo])
  @@map("data_revisions")
}

/// §5.1's reason codes, verbatim. Mirrors RevisionReason in
/// src/lib/risk/data-revision.ts.
enum RevisionReason {
  import
  correction
  mapping_change
  late_adjustment
  external_refresh
  manual_override
}
