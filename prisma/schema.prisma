// BudgetPro — Standalone Budgeting App
// Extracted from LeadDrive CRM v2

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════
// ORGANIZATION & AUTH
// ═══════════════════════════════════════════════════

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  settings      Json     @default("{}")
  // Phase 7.G Turn LXVII (Phase 4.2 — period locking foundation).
  // Shape: `Array<{ period: string; lockedAt: ISO-string; lockedBy: userId; reason?: string }>`.
  // `period` matches the canonical format ("YYYY", "YYYY-Q[1-4]", "YYYY-MM").
  // Mutations on locked periods MUST be rejected by `period-lock.ts:isPeriodLocked()`.
  // Admin-only lock/unlock via Phase 4.2 admin UI (next slice).
  // Default `[]` — no periods locked by default; opt-in per org.
  lockedPeriods Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  periodSnapshots        PeriodSnapshot[]
  guideViews             GuideView[]
  users                  User[]
  budgetPlans            BudgetPlan[]
  budgetCostTypes        BudgetCostType[]
  budgetDepartments      BudgetDepartment[]
  budgetDirectionTemplates BudgetDirectionTemplate[]
  budgetSections         BudgetSection[]
  salesForecasts         SalesForecast[]
  expenseForecasts       ExpenseForecast[]
  budgetDeptOwners       BudgetDepartmentOwner[]
  budgetApprovalComments BudgetApprovalComment[]
  approvalRequests       ApprovalRequest[]
  currencyRateHistory    CurrencyRateHistory[]
  accountingIntegrations AccountingIntegration[]
  accountingImports      AccountingImport[]
  rollingForecastMonths  RollingForecastMonth[]
  cashFlowEntries        CashFlowEntry[]
  cashFlowAlerts         CashFlowAlert[]
  chartOfAccounts        ChartOfAccount[]
  productLines           ProductLine[]
  salesBudgetLines       SalesBudgetLine[]
  costComponents         CostComponent[]
  cogsBudgetLines        COGSBudgetLine[]
  cogsCostDetails        COGSCostDetail[]
  balanceSheetLines      BalanceSheetLine[]
  budgetAssumptions      BudgetAssumption[]
  // Phase 7.J — top customers / suppliers register
  counterparties         Counterparty[]

  // Phase 7 — Risk & Performance Indicators (FO Holding foundation)
  companies             Company[]
  indicatorDefinitions  IndicatorDefinition[]
  alerts                Alert[]
  alertEvents           AlertEvent[]
  alertRules            AlertRule[]
  scenarios             Scenario[]
  importStaging         ImportStaging[]
  terminalLayouts       UserLayoutPreference[]
  auditEvents           AuditEvent[]
  dataRevisions         DataRevision[]
  intelItems            IntelItem[]
  boardDeckNarrations   BoardDeckNarration[]
  // Phase 7.G Turn LXXXXI batch — back-relations for 5 NEW v2 models.
  aiMapperProposalCache AIMapperProposalCache[]
  aiTokenUsage          AITokenUsage[]
  intelDataPoints       IntelDataPoint[]
  varianceExplanations  VarianceExplanation[]
  predictiveBreaches    PredictiveBreach[]
  feedImpactForecasts   FeedImpactForecast[]
  tradeSpendLedgerEntries TradeSpendLedger[]
}

model User {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email              String
  name               String
  passwordHash       String
  role               String       @default("viewer")
  // Phase 7.F sub-group RBAC. Empty array = full org access (admins,
  // CFO). Non-empty = user can only see these sub-group Company IDs
  // and their operational children. `admin` role bypasses regardless.
  allowedSubGroupIds String[]     @default([])
  avatar             String?
  phone              String?
  department         String?
  lastLogin          DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  budgetDeptOwnership  BudgetDepartmentOwner[]
  accounts             Account[]
  importStagingCreated ImportStaging[]         @relation("ImportStagingCreator")
  terminalLayouts      UserLayoutPreference[]
  auditEvents          AuditEvent[]            @relation("AuditEventActor")
  dataRevisions        DataRevision[]          @relation("DataRevisionCreatedBy")

  @@unique([organizationId, email])
  @@map("users")
}

// Phase 7.D — saved Bloomberg-terminal pane sizes per user. Stored
// independently from the localStorage `onLayoutChanged` autosave (the
// "remember last session" baseline) so users can keep multiple named
// workspaces (e.g. "morning brief", "audit", "FX scan") and switch
// between them.
//
// `sizes` shape (matches `LayoutSizes` in
// `src/features/terminal/lib/layout-sizes.ts`):
//   {
//     outer:  { "row-top": pct, "row-bottom": pct },
//     top:    { "p1": pct, "p2": pct },
//     bottom: { "p3": pct, "p4": pct },
//   }
// Each panel-id map sums to ~100 (within 0.5pt FP tolerance). Panel
// ids match the `PANEL_IDS` const + the `id` props on Panels in
// PanelGrid; if structure changes (e.g. adding Panel 5), older saved
// rows fall back to defaults via `validateLayoutSizes` rather than
// rendering a half-broken layout.
model UserLayoutPreference {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String // "morning brief", "audit", etc.
  sizes          Json // see jsdoc above
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Per-user uniqueness on (userId, name) — overwriting an existing
  // name is the upsert path the API uses.
  @@unique([userId, name])
  @@index([organizationId, userId])
  @@map("user_layout_preferences")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ═══════════════════════════════════════════════════
// CURRENCY
// ═══════════════════════════════════════════════════

model Currency {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  symbol         String
  exchangeRate   Float    @default(1.0)
  isBase         Boolean  @default(false)
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@map("currencies")
}

model CurrencyRateHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currencyCode   String
  rate           Float
  rateDate       DateTime
  createdAt      DateTime     @default(now())

  @@index([organizationId, currencyCode, rateDate])
  @@map("currency_rate_history")
}

// ═══════════════════════════════════════════════════
// ACCOUNTING INTEGRATION
// ═══════════════════════════════════════════════════

model AccountingIntegration {
  id              String             @id @default(cuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider        String
  name            String
  config          Json               @default("{}")
  categoryMapping Json               @default("{}")
  isActive        Boolean            @default(true)
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  lastSyncError   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  imports         AccountingImport[]

  @@index([organizationId])
  @@map("accounting_integrations")
}

model AccountingImport {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationId  String?
  integration    AccountingIntegration? @relation(fields: [integrationId], references: [id])
  planId         String
  plan           BudgetPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  fileName       String?
  importType     String
  status         String                 @default("pending")
  totalRows      Int                    @default(0)
  matchedRows    Int                    @default(0)
  unmatchedRows  Int                    @default(0)
  errors         Json?
  createdAt      DateTime               @default(now())

  @@index([organizationId])
  @@index([planId])
  @@map("accounting_imports")
}

// ═══════════════════════════════════════════════════
// ROLLING FORECAST
// ═══════════════════════════════════════════════════

model RollingForecastMonth {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           BudgetPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  status         String       @default("forecast")
  lockedAt       DateTime?
  createdAt      DateTime     @default(now())

  @@unique([planId, year, month])
  @@index([organizationId])
  @@map("rolling_forecast_months")
}

// ═══════════════════════════════════════════════════
// CASH FLOW FORECASTING
// ═══════════════════════════════════════════════════

model CashFlowEntry {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  entryType      String
  source         String
  sourceId       String?
  amount         Float
  currencyCode   String          @default("AZN")
  description    String?
  paymentDate    DateTime?
  isProjected    Boolean         @default(true)
  activityType   String          @default("operating")
  accountId      String
  account        ChartOfAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // 2026-06-23 — companyId mirrors BalanceSheetLine so cash flow can be scoped
  // per company (holding vs child) and the holding-CF double-layer cannot recur.
  // Nullable: legacy rows + any consolidated/holding layer carry null.
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  counterpartyId String?
  plannedAmount  Float?
  createdAt      DateTime        @default(now())
  // Phase 7.M Step 4 (2026-05-18) — soft-delete for self-service archive.
  deletedAt      DateTime?
  deletedBy      String?

  @@index([organizationId, year, month])
  @@index([organizationId, activityType])
  @@index([accountId])
  @@index([organizationId, deletedAt])
  @@index([companyId])
  @@index([companyId, year, month])
  @@map("cash_flow_entries")
}

model CashFlowAlert {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year             Int
  month            Int
  alertType        String
  message          String
  threshold        Float?
  projectedBalance Float
  isResolved       Boolean      @default(false)
  createdAt        DateTime     @default(now())

  @@index([organizationId])
  @@map("cash_flow_alerts")
}

// ═══════════════════════════════════════════════════
// BUDGET CHANGE LOG
// ═══════════════════════════════════════════════════

model BudgetChangeLog {
  id             String   @id @default(cuid())
  organizationId String
  planId         String
  entityType     String
  entityId       String
  action         String
  field          String?
  oldValue       Json?
  newValue       Json?
  snapshot       Json?
  userId         String?
  createdAt      DateTime @default(now())

  @@index([planId, createdAt])
  @@index([organizationId])
  @@map("budget_change_logs")
}

// ═══════════════════════════════════════════════════
// BUDGET CORE
// ═══════════════════════════════════════════════════

model BudgetCostType {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key              String
  label            String
  costModelPattern String?
  isShared         Boolean      @default(false)
  allocationMethod String?
  color            String?
  sortOrder        Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  budgetLines        BudgetLine[]
  budgetActuals      BudgetActual[]
  forecastEntries    BudgetForecastEntry[]
  directionTemplates BudgetDirectionTemplate[]
  expenseForecasts   ExpenseForecast[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("budget_cost_types")
}

model BudgetDepartment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  label          String
  serviceKey     String?
  hasRevenue     Boolean      @default(true)
  color          String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  budgetLines        BudgetLine[]
  budgetActuals      BudgetActual[]
  forecastEntries    BudgetForecastEntry[]
  directionTemplates BudgetDirectionTemplate[]
  salesForecasts     SalesForecast[]
  expenseForecasts   ExpenseForecast[]
  owners             BudgetDepartmentOwner[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("budget_departments")
}

model BudgetPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  periodType     String       @default("monthly")
  year           Int
  month          Int?
  quarter        Int?
  status         String       @default("draft")
  // Decouple plan (2026-06-02): distinguishes a plan holding ACTUAL realized
  // results (the Risk Terminal's P&L/BS source) from one holding a forward
  // BUDGET. Default "actual" so every pre-existing plan keeps feeding the
  // terminal unchanged; only an explicit budget plan is excluded from it.
  kind           String       @default("actual")
  notes          String?
  submittedBy    String?
  submittedAt    DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  amendmentOf    String?
  version        Int          @default(1)
  versionLabel   String?
  snapshotData   Json?
  isRolling      Boolean      @default(false)
  rollingMonths  Int          @default(12)
  // Soft-delete: set to the deletion timestamp when the plan is "deleted".
  // A background cleanup job physically removes rows older than 30 days.
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines                 BudgetLine[]
  actuals               BudgetActual[]
  sections              BudgetSection[]
  forecastEntries       BudgetForecastEntry[]
  approvalComments      BudgetApprovalComment[]
  approvalRequests      ApprovalRequest[]
  accountingImports     AccountingImport[]
  rollingForecastMonths RollingForecastMonth[]
  salesBudgetLines      SalesBudgetLine[]
  cogsBudgetLines       COGSBudgetLine[]
  cogsCostDetails       COGSCostDetail[]
  balanceSheetLines     BalanceSheetLine[]
  budgetAssumptions     BudgetAssumption[]

  @@index([organizationId])
  // Phase 11.4 (2026-07-29) — the UNIQUE backstop lives in
  // prisma/migrations/20260729120000_budget_plan_unique_per_year_kind as a
  // PARTIAL index (`WHERE "deletedAt" IS NULL`), which Prisma's schema
  // language cannot express. Do NOT replace it with a plain @@unique: that
  // would also constrain soft-deleted plans, which may legitimately repeat a
  // (year, kind) a live plan now occupies. Application-side resolution is
  // src/lib/onboarding/resolve-plan.ts — every import path must call it.
  @@map("budget_plans")
}

model BudgetLine {
  id             String            @id @default(cuid())
  organizationId String
  planId         String
  plan           BudgetPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  department     String?
  lineType       String            @default("expense")
  lineSubtype    String?
  plannedAmount  Float             @default(0)
  forecastAmount Float?
  unitPrice      Float?
  unitCost       Float?
  quantity       Int?
  costModelKey   String?
  // Turn 29 (Bug #1b): default reverted from true → false. Auto-planning
  // requires a populated cost model + sales/expense forecasts; defaulting
  // every line to "compute me dynamically" was wrong for the dominant case
  // of literal imports (xlsx-sourced AZMADE BudgetLines have explicit
  // plannedAmount values that were silently zeroed by getEffectivePlanned
  // when the dynamic-source side returned 0).
  isAutoPlanned  Boolean           @default(false)
  isAutoActual   Boolean           @default(false)
  costTypeId     String?
  costType       BudgetCostType?   @relation(fields: [costTypeId], references: [id], onDelete: SetNull)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  // Phase 2.1 session 3: accountId is now NOT NULL. The wipe script removed
  // all orphan rows (rows without a valid accountId) before this change.
  accountId      String
  account        ChartOfAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  // Phase 7 — Risk & Performance Indicators: every BudgetLine belongs to an
  // operational Company (level 2) under a sub-group (level 1) under FO Holding
  // (Organization). Nullable for backward compat; backfilled at 7.A end.
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  vatIncluded    Boolean           @default(false)
  vatRate        Float?
  amountExVat    Float?
  currencyCode   String?
  exchangeRate   Float?
  originalAmount Float?
  notes          String?
  sortOrder      Int               @default(0)
  // Phase 7.G Turn XL (Phase A.1) — explicit 0-indexed month for BudgetLine
  // rows. 0=Jan..11=Dec. Nullable for legacy/annual/rollup-derived rows
  // (resolvers handle null defensively per `recompute.ts:107`). All NEW
  // writers (`import-azmade-budgets.ts`, AI-mapper /apply, seed scripts,
  // verify-reimport clone) tag this on insert. Pre-Phase-A rows derive
  // `monthIndex` from `sortOrder % 100` per the legacy convention; backfill
  // ships as a user-owned 🔄 (mass UPDATE on shared DB needs explicit
  // permission, same boundary as Turn XXXIX currencyCode backfill).
  monthIndex     Int?
  // Phase 7.M Step 4 (2026-05-18) — soft-delete for self-service archive.
  // Mirrors the pattern on `BudgetPlan.deletedAt` (line ~419). Read
  // paths filter via `where: { deletedAt: null }` through the helper
  // in `src/lib/server/soft-delete.ts`; archived rows stay queryable
  // for 90 days via the admin restore UI, then a cleanup job purges.
  deletedAt      DateTime?
  deletedBy      String?
  parentId       String?
  parent         BudgetLine?       @relation("LineChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       BudgetLine[]      @relation("LineChildren")
  // Financial-truth-infra Phase A.2 — source-of-record pointer. Mirrors the
  // same provenance field on `IndicatorValue` so drift watchdog can hop
  // from a divergent indicator down to the specific budget line + source
  // xlsx cell that contributed. Typically `filename.xlsx#sheet!cell_ref`
  // for direct xlsx imports, or `cli:import-X.ts` for CLI-driven loads.
  // Nullable for backward compat with pre-Phase-A budget lines.
  sourceDocument String?

  @@index([organizationId])
  @@index([planId])
  @@index([parentId])
  @@index([costTypeId])
  @@index([departmentId])
  @@index([accountId])
  @@index([companyId])
  // Phase 7.G Turn XL — query shape for sparkline + monthly aggregations
  // (resolvers join on (planId, companyId) and bucket by monthIndex).
  @@index([planId, companyId, monthIndex])
  @@map("budget_lines")
}

model BudgetActual {
  id             String            @id @default(cuid())
  organizationId String
  planId         String
  plan           BudgetPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  category       String
  department     String?
  lineType       String            @default("expense")
  actualAmount   Float             @default(0)
  expenseDate    String?
  description    String?
  currencyCode   String?
  exchangeRate   Float?
  originalAmount Float?
  // Phase 3.1 v1.2 (Turn LIX v1.2) — explicit 0-indexed month for
  // BudgetActual rows. 0=Jan..11=Dec. Mirrors BudgetLine.monthIndex
  // shape so VarianceTab sparkline can overlay actual vs planned per
  // month. Nullable for backfill compatibility — pre-migration rows
  // derive from expenseDate parse-fallback at read time; new writes
  // stamp at insert. Backfill script:
  //   scripts/backfill-budget-actual-month-index.sh (Turn LIX v1.2)
  monthIndex     Int?
  costTypeId     String?
  costType       BudgetCostType?   @relation(fields: [costTypeId], references: [id], onDelete: SetNull)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  // Turn 35: per-company filter for /api/budgeting/pnl + analytics. Without
  // companyId, actuals couldn't be filtered to a single op-co — the per-
  // daughter-company drilldown showed org-wide actuals against per-company
  // plan, producing nonsense variance %. Nullable for legacy rows (any
  // pre-Turn-35 actuals stay null and fall through global aggregation).
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([planId])
  @@index([costTypeId])
  @@index([departmentId])
  @@index([companyId])
  @@map("budget_actuals")
}

model BudgetSection {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           BudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name           String
  sectionType    String     @default("expense")
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([organizationId])
  @@index([planId])
  @@map("budget_sections")
}

model BudgetForecastEntry {
  id             String            @id @default(cuid())
  organizationId String
  planId         String
  plan           BudgetPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  category       String
  lineType       String            @default("expense")
  forecastAmount Float             @default(0)
  costTypeId     String?
  costType       BudgetCostType?   @relation(fields: [costTypeId], references: [id], onDelete: SetNull)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([planId, year, month, category, lineType])
  @@index([organizationId])
  @@index([planId])
  @@index([costTypeId])
  @@index([departmentId])
  @@map("budget_forecast_entries")
}

model BudgetDirectionTemplate {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  lineType       String            @default("revenue")
  lineSubtype    String?
  defaultAmount  Float             @default(0)
  unitPrice      Float?
  unitCost       Float?
  quantity       Int?
  costModelKey   String?
  department     String?
  costTypeId     String?
  costType       BudgetCostType?   @relation(fields: [costTypeId], references: [id], onDelete: SetNull)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sortOrder      Int               @default(0)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([costTypeId])
  @@index([departmentId])
  @@map("budget_direction_templates")
}

model SalesForecast {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  budgetDept     BudgetDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  amount         Float            @default(0)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, departmentId, year, month])
  @@index([organizationId])
  @@index([organizationId, year])
  @@map("sales_forecasts")
}

model ExpenseForecast {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costTypeId     String
  budgetCostType BudgetCostType    @relation(fields: [costTypeId], references: [id], onDelete: Cascade)
  departmentId   String?
  budgetDept     BudgetDepartment? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
