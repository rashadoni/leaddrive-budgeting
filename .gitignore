# Local-only Claude / Truth-Infra artifacts
.claude/scheduled_tasks.lock
data/onboarding-source-registry.json

# Real client workbooks — uploaded for analysis, NEVER committed. Only the
# `.example.json` registry belongs in git.
data/*.xlsx
data/*.xlsm
data/*.docx
data/*/

# Dependencies
node_modules/
# …and the same name without the trailing slash. Git worktrees under
# .claude/worktrees/ symlink node_modules to the main checkout, and a pattern
# ending in "/" matches directories only — so the symlink showed up as an
# untracked file that `git add -A` would happily commit.
node_modules
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Production
/dist

# Secrets — NEVER commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# 2026-08-04 — a `.env.bak-<date>` holding a live ANTHROPIC_API_KEY was sitting
# un-ignored in the working tree and got staged by a routine `git add -A`. The
# pre-commit secret scanner caught it, which is the last line of defence, not
# the first. A backup of an env file is an env file.
.env.bak*
.env.*.bak*
prisma/.env

