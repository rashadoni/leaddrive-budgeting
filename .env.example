DATABASE_URL="postgresql://user:password@localhost:5432/budgetpro"
# Phase 5.2 Stage 2 — RLS bypass connection for cron / workers /
# migrations. Provisioned via scripts/sql/create-bypass-role.sql.
# Optional until RLS migrations land; the admin Prisma client falls
# back to DATABASE_URL with a console.warn when this is absent.
DATABASE_URL_ADMIN="postgresql://budgetpro_admin:password@localhost:5432/budgetpro"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
ANTHROPIC_API_KEY=""
# Phase 6 (2026-05-21) — BullMQ queue backend toggle. Default "inprocess"
# keeps the legacy job-runner. Switch to "bullmq" after running the
# worker daemon (see docs/QUEUE_RUNBOOK.md).
QUEUE_BACKEND=""
REDIS_URL=""
# Phase 10 / Stage A4 (2026-07-16) — Risk Terminal 2.0 rollout flags.
# Server-only: read by src/features/terminal/lib/terminal-experience-flag.ts
# and passed to the client as props. Never rename these to NEXT_PUBLIC_* —
# a client-side read diverges from SSR.
# Master switch. Only the literal "true" enables; anything else fails closed.
RISK_TERMINAL_V2_ENABLED="false"
# Comma-separated EXACT organization IDs (case-sensitive). An empty list is a
# valid disabled state and enables NOBODY — it is not a wildcard, and "*" has
# no special meaning. V2 needs ENABLED=true AND membership here.
RISK_TERMINAL_V2_ORG_ALLOWLIST=""
# today | portfolio | company | scenarios | data-health | expert
# Unknown values fall back to "expert" (the legacy view). Applies only to
# orgs that are actually V2-enabled.
RISK_TERMINAL_V2_DEFAULT_VIEW="expert"
# Permits paid AI to run on terminal entry. Keep false: autorun on entry
# spends money without user action.
RISK_TERMINAL_V2_AI_AUTORUN="false"
