# =============================================================================
# BudgetPro — production environment template
#
# Copy to .env.production on the VM and fill in real values:
#   cp .env.production.example .env.production
#   nano .env.production
#
# Then load into docker compose:
#   docker compose --env-file .env.production up -d --build
#
# DO NOT commit the filled-in .env.production to git (.gitignore excludes it).
# Keep it 0600, owned by the docker-running user. See docs/DEPLOYMENT_READINESS.md
# §1 for the full var matrix (supplier / rotation / failure mode per var).
#
# Legend:  [REQUIRED] app will not work without it · [OPTIONAL] safe default.
# =============================================================================

# ------ PostgreSQL container (read by the `db` + `app` containers) -----------
# [REQUIRED for deploy] These init the Postgres container.
POSTGRES_USER=budgetpro
# Generate with: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_24CHARS
POSTGRES_DB=budgetpro

# ------ Database connection strings (read by Prisma in the `app` container) --
# [REQUIRED] Prisma reads DATABASE_URL (prisma/schema.prisma). Build the value
# yourself (left blank here so this template trips no secret scanner):
#   scheme `postgresql`, credentials = POSTGRES_USER + POSTGRES_PASSWORD above,
#   host = the compose service name `db`, port 5432, database = POSTGRES_DB,
#   query `?schema=public`.
DATABASE_URL=

# [REQUIRED — Phase 5.2 RLS] Row-Level-Security tenant isolation uses TWO
# Postgres roles (provisioned by the RLS migrations / deploy/README.md):
#   - budgetpro_admin : BYPASSRLS — migrations + admin/cron paths
#   - budgetpro_app   : NO BYPASSRLS — org-scoped request handlers
#                       (everything wrapped in withOrgScope — 16 routes today)
# Each = same host/port/database as DATABASE_URL, with that role's name +
# password. If unset, withOrgScope falls back to the default client and RLS is
# NOT enforced at the DB layer (app-layer org-scoping still holds, but you lose
# the defence-in-depth). Set both for a hardened deploy.
DATABASE_URL_ADMIN=
DATABASE_URL_APP=

# ------ Next.js auth (Auth.js v5) --------------------------------------------
# [REQUIRED] Generate with: openssl rand -base64 32
# Rotating this invalidates ALL sessions (users must re-login).
NEXTAUTH_SECRET=CHANGE_ME_32_BYTES_BASE64

# [REQUIRED] Public URL the app is reached at (no trailing slash). Must match
# the real scheme+host or login redirects break.
#   https://budget.fo.az   (production, TLS)  ·  http://203.0.113.5  (IP, no TLS)
NEXTAUTH_URL=https://budget.fo.az

# ------ NODE_ENV -------------------------------------------------------------
# [REQUIRED] Must be "production" in prod (the Docker image sets this; listed
# here for completeness — a wrong value ships dev-mode output).
NODE_ENV=production

# ------ First admin bootstrap (scripts/create-admin.ts — run ONCE) -----------
# [OPTIONAL — script-only] Used only by the create-admin seed script on first
# deploy; not read at runtime. Omit to accept the script's fallbacks, but set
# a strong ADMIN_PASSWORD so the first login isn't a known default.
ADMIN_EMAIL=admin@fo.az
ADMIN_PASSWORD=CHANGE_ME_FIRST_ADMIN_PW
ADMIN_ORG_NAME=FO Holding
ADMIN_ORG_SLUG=fo-holding

# ------ Background job queue (Phase 6 — BullMQ; default in-process) -----------
# [OPTIONAL] Leave QUEUE_BACKEND unset (or "inprocess") to run recomputes
# in-request (fine for FO Holding's single-VM scale). Set "bullmq" + REDIS_URL
# only if you run the dedicated worker (scripts/run-worker.ts) — see
# docs/QUEUE_RUNBOOK.md.
QUEUE_BACKEND=inprocess
# REDIS_URL=redis://redis:6379

# ------ AI / external providers (all OPTIONAL — graceful degradation) --------
# Leave ANTHROPIC_API_KEY empty to disable AI features (Variance/Forecast
# Explainer, AI Data Mapper) — the app degrades gracefully. Per-org keys can
# also be set in-app (Organization.settings.apiKeys, Phase 7.K/C4).
ANTHROPIC_API_KEY=
# Provider selectors — defaults are fine; only set to switch implementations.
# LLM_PROVIDER=anthropic
# WEB_SEARCH_PROVIDER=
# EMAIL_PROVIDER=in-memory   # no real SMTP pipeline yet; alerts surface in-app

# ------ Logging --------------------------------------------------------------
# [OPTIONAL] Structured logger level (src/lib/log.ts): debug|info|warn|error.
# Default info. LOG_IN_TESTS is test-only (never set in prod).
LOG_LEVEL=info

# ------ Feature flags (OPTIONAL) ---------------------------------------------
# FEATURE_FEED_IMPACT_FORECASTER=1   # enable the impact-forecaster intel feed
# TERMINAL_LIVE_DISABLED=1           # kill-switch for the live SSE terminal feed
# CLEANUP_CRON=0 3 * * *             # daily soft-delete physical-purge schedule

# NOTE: GUIDE_BASE_URL / GUIDE_EMAIL / GUIDE_PASSWORD are e2e-test-only
# (scripts + Playwright) — do NOT set them in production.
