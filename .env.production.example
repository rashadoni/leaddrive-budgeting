# =============================================================================
# BudgetPro — production environment template
#
# Copy to .env.production on the VM and fill in real values:
#   cp .env.production.example .env.production
#   nano .env.production
#
# Then load into docker compose:
#   docker compose --env-file .env.production up -d --build
#
# DO NOT commit the filled-in .env.production to git.
# =============================================================================

# ------ PostgreSQL (read by BOTH the db and app containers) ------------------

POSTGRES_USER=budgetpro
# Generate with: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_24CHARS
POSTGRES_DB=budgetpro

# ------ Next.js auth ---------------------------------------------------------

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_32_BYTES_BASE64

# Public URL the app is reached at (no trailing slash).
# Examples:
#   https://budget.fo.az          # production with TLS + domain
#   http://203.0.113.5            # initial deploy with public IP, no TLS
#   http://10.20.30.5             # internal-only deploy
NEXTAUTH_URL=https://budget.fo.az

# ------ Anthropic (optional — AI Analytics) ----------------------------------
# Leave empty to disable AI features on prod.
ANTHROPIC_API_KEY=
